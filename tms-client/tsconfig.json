{
  "compilerOptions": {
    "rootDir": "./",
    "outDir": "./dist",
    "module": "Node16",
    "target": "ES2020",
    "moduleResolution": "node16",
    "strict": true,
    "strictNullChecks": true,
    "noUncheckedIndexedAccess": true,
    "skipLibCheck": true
  },
  "include": ["**/*.ts"],
  "exclude": ["node_modules", "dist"]
}